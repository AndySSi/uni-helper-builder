{
  "name": "@shivip/uni-helper-builder",
  "version": "2.0.0",
  "description": "交互式命令行代码生成器，面向公司基于 uni-app（快应用/小程序）的前端项目。它按照团队约定的 DDD（领域驱动设计）分层架构，通过命令行问答的方式自动生成领域模板、用例、数据模型（DTO）等样板代码，并支持多应用主体切换开发。",
  "main": "index.js",
  "typings": "types/index.d.ts",
  "scripts": {
    "dev": "webpack --watch",
    "build": "webpack"
  },
  "bin": {
    "brc": "bin/index.js"
  },
  "files": [
    "bin",
    "dist",
    "omit_dto_decorators.cjs",
    "types"
  ],
  "keywords": [],
  "type": "module",
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@types/babel__generator": "^7.6.7",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.20.4",
    "@types/node": "^20.19.43",
    "fs-extra": "^11.2.0",
    "path-browserify": "^1.0.1",
    "prettier": "^3.1.1",
    "ts-chained-ast": "^1.0.0",
    "ts-dedent": "^2.2.0",
    "ts-interface-checker": "^1.0.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "ts-toolbelt": "^9.6.0",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "env-paths": "^3.0.0",
    "vite-plugin-babel": "^1.2.0"
  }
}
